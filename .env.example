# Environment Variables for Smart Parking AI

# Application
PROJECT_NAME="Smart Parking Vision System"
API_V1_STR="/api/v1"
DEBUG=True
LOG_LEVEL="INFO"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="parking_ai"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/parking_ai"
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/parking_ai_test"

# ML & Inference
DEFAULT_MODEL_NAME="yolo11n"
MODEL_DEVICE="cpu"  # "cpu", "cuda", or "mps"
MODEL_WEIGHTS_PATH="checkpoints/yolo11n.pt"
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Occupancy Engine
CONSECUTIVE_FRAMES_THRESHOLD=5
SLOT_OCCUPANCY_IOU_THRESHOLD=0.3
